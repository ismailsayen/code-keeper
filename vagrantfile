# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  # -------------------------------------------------------------------
  # 1. Configuration Constants
  # -------------------------------------------------------------------
  VM_NAME = "Code-Keeper-VM"

  # Fix for SSH authentication failures on exported/imported VMs
  config.ssh.insert_key = false

  # -------------------------------------------------------------------
  # 2. Base Box & Network
  # -------------------------------------------------------------------
  config.vm.box = "ubuntu/jammy64"
  config.vm.hostname = "code-keeper-server"

  config.vm.disk :disk, size: "50GB", name: "gitlab_storage"

  # BRIDGED NETWORK: Makes VM act as a separate laptop on your router
  # It will request its own IP address directly from your home Wi-Fi/Router (DHCP)
  config.vm.network "public_network"

  # Web UI Port Forwarding
  config.vm.network "forwarded_port", guest: 80,  host: 8080, host_ip: "0.0.0.0", auto_correct: true
  config.vm.network "forwarded_port", guest: 443, host: 8443, host_ip: "0.0.0.0", auto_correct: true
  
  # SSH Port Forwarding
  config.vm.network "forwarded_port", guest: 22,  host: 2222, id: "ssh", auto_correct: true

  # -------------------------------------------------------------------
  # 3. VirtualBox Provider Settings
  # -------------------------------------------------------------------
  config.vm.provider "virtualbox" do |vb|
    vb.name   = VM_NAME
    vb.memory = "8192"
    vb.cpus   = 4
    
    vb.customize ["modifyvm", :id, "--natdnshostresolver1", "on"]
    vb.customize ["modifyvm", :id, "--ioapic", "on"]
  end

  # -------------------------------------------------------------------
  # 4. Script-Based Provisioning
  # -------------------------------------------------------------------
  config.vm.provision "shell" do |s|
    s.path = "scripts/setup_gitlab.sh"
  end
end