# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  # Prevents 'vagrant destroy' from executing without explicit confirmation
  # config.vm.define "code-keeper-server" do |server|
  #   server.vm.prevent_destroy = true
  # end

  config.vm.box = "ubuntu/jammy64"
  config.vm.hostname = "code-keeper-server"

  # 50GB storage for GitLab
  config.vm.disk :disk, size: "50GB", name: "gitlab_storage"

  # Standard NAT + Forwarded ports
  config.vm.network "forwarded_port", guest: 22, host: 2222, id: "ssh", auto_correct: true
  config.vm.network "forwarded_port", guest: 80, host: 8080

  config.vm.provider "virtualbox" do |vb|
    vb.name   = "Code-Keeper-VM"
    vb.memory = "8192"
    vb.cpus   = 4
  end

end